<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro
    name="jackal_base"
    params="PI footprint_vertical_offset chassis_length chassis_width chassis_height lidar_height lidar_back_offset">

    <link name="base_link"/>

    <joint name="base_link_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="chassis_link"/>
    </joint>

    <link name="chassis_link">

        <visual>
            <origin
                xyz="0 0 ${footprint_vertical_offset}"
                rpy="${PI/2} 0 ${PI/2}"
            />

            <geometry>
                <mesh filename="package://jackal_description/meshes/jackal-base.stl"/>
            </geometry>

            <material name="dark_grey"/>
        </visual>

        <collision>
            <origin xyz="0 0 ${chassis_height/2}"/>

            <geometry>
                <box
                    size="${chassis_length} ${chassis_width} ${chassis_height}"
                />
            </geometry>
        </collision>

        <inertial>
            <!-- Center of mass -->
            <origin xyz="0.012 0.002 0.067" rpy="0 0 0"/>

            <mass value="16.523"/>

            <!-- Moments of inertia: (chassis without wheels) -->
            <inertia
                ixx="0.3136"
                ixy="-0.0008"
                ixz="0.0164"
                iyy="0.3922"
                iyz="-0.0009"
                izz="0.4485"
            />
        </inertial>

    </link>

    <link name="hokuyo_lidar">
        <visual>
            <geometry>
                <mesh filename="package://jackal_description/meshes/hokuyo_ust10.stl"/>
            </geometry>
         <material name="SensorGrey"/>
        </visual>
    </link>

    <joint name="lidar_joint" type="fixed">
        <origin xyz="${(chassis_length/2) - lidar_back_offset} 0 ${chassis_height}"/>
        <parent link="chassis_link"/>
        <child link="hokuyo_lidar"/>
    </joint>

    <link name="front_fender_link">
    <visual>
        <geometry>
            <mesh filename="package://jackal_description/meshes/accessory_fender.stl"/>
        </geometry>

        <material name="yellow"/>
    </visual>
</link>

<link name="front_fender_accessory_link"/>

<joint name="front_fender_accessory_joint" type="fixed">
    <origin
        xyz="0.25629 0 0.07455"
        rpy="${PI} 0 0"
    />

    <parent link="front_fender_link"/>
    <child link="front_fender_accessory_link"/>
</joint>

<joint name="front_fender_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>

    <parent link="chassis_link"/>
    <child link="front_fender_link"/>
</joint>

<link name="rear_fender_link">
    <visual>
        <geometry>
            <mesh filename="package://jackal_description/meshes/accessory_fender.stl"/>
        </geometry>

        <material name="yellow"/>
    </visual>
</link>

<link name="rear_fender_accessory_link"/>

<joint name="rear_fender_accessory_joint" type="fixed">
    <origin
        xyz="0.25629 0 0.07455"
        rpy="${PI} 0 0"
    />

    <parent link="rear_fender_link"/>
    <child link="rear_fender_accessory_link"/>
</joint>

<joint name="rear_fender_joint" type="fixed">
    <origin
        xyz="0 0 0"
        rpy="0 0 ${PI}"
    />

    <parent link="chassis_link"/>
    <child link="rear_fender_link"/>
</joint>


</xacro:macro> 
</robot>